---

# Generic
generic:
  role: ansible-role-windows_dnsserver
  role_short: windows_dnsserver
  role_description: |
    Installs Windows DNS server.
    Purpose of this role is to build a DNS server to be used for Linux client testing.
  collections: []

# Supported platforms
platforms:
  rhel8:
    supported: false
    ci: false
  rhel9:
    supported: false
    ci: false
  rhel10:
    supported: false
    ci: false
  rockylinux8:
    supported: false
    ci: false
  rockylinux9:
    supported: false
    ci: false
  rockylinux10:
    supported: false
    ci: false
  oraclelinux8:
    supported: false
    ci: false
  oraclelinux9:
    supported: false
    ci: false
  oraclelinux10:
    supported: false
    ci: false
  almalinux8:
    supported: false
    ci: false
  almalinux9:
    supported: false
    ci: false
  almalinux10:
    supported: false
    ci: false
  debian11:
    supported: false
    ci: false
  debian12:
    supported: false
    ci: false
  debian13:
    supported: false
    ci: false
  ubuntu2204:
    supported: false
    ci: false
  ubuntu2404:
    supported: false
    ci: false
  fedora42:
    supported: false
    ci: false
  fedora43:
    supported: false
    ci: false
  win2012r2:
    supported: true
    ci: false
  win2016:
    supported: true
    ci: false
  win2019:
    supported: true
    ci: false
  win2022:
    supported: true
    ci: false
  win2025:
    supported: true
    ci: false

# Dependecies
dependencies:
  collections:
    - ansible.windows
    - community.windows
  roles: []

# Molecule
molecule:
  driver: vagrant
  provider: virtualbox
  requirements:
    roles_extra:
      - deitkrachten.windows_features
  prepare:
    vars:
      auto_logon: true
  converge:
    vars:
      windows_dnsserver_domain: example.com
      windows_dnsserver_network: "192.168.56.0/24"
      windows_dnsserver_reverse_zone: "56.168.192.in-addr.arpa"
      windows_dnsserver_zones:
        - name: "{{ windows_dnsserver_domain }}"
      windows_dnsserver_reverse_zones:
        - networkid: "{{ windows_dnsserver_network }}"
          zone: "{{ windows_dnsserver_reverse_zone }}"
      windows_dnsserver_records:
        - name: windc
          ip: 192.168.56.100
        - name: vm1
          ip: 192.168.56.101
        - name: vm2
          ip: 192.168.56.102
        - name: vm3
          ip: 192.168.56.103
        - name: vm4
          ip: 192.168.56.104

# Github
github:
  molecule: false
